// ============================================================================
// Feedback & Injury Models
// ============================================================================
// Post-activity feedback system and injury tracking. Feedback questions are
// asked after activities, and responses can be used to extract injury information
// and generate embeddings for AI-powered insights.
// ============================================================================

/// Activity feedback question.
/// Represents a question asked to the athlete after an activity. Questions
/// can be multiple choice (QCM) or open-ended. Answers are stored in answerText
/// and qcmOptions contains the question structure.
model ActivityFeedbackQuestion {
  // primary key
  activityFeedbackQuestionId Int @id @default(autoincrement()) @map("activity_feedback_question_id")

  // fields
  /// Question text
  questionText String  @map("question_text")
  /// Multiple choice options (JSON structure, null for open-ended questions)
  qcmOptions   Json?   @map("qcm_options")
  /// Answer text provided by the athlete
  answerText   String? @map("answer_text")

  // relationships
  activity        EventActivity @relation(fields: [eventActivityId], references: [eventActivityId])
  eventActivityId Int           @map("event_activity_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventActivityId])
  @@map("activity_feedback_question")
}

/// Athlete injury record.
/// Tracks injuries reported by athletes, either manually or extracted from
/// activity feedback. Injuries can be linked to a source activity and have
/// a status (WORSENING, IMPROVING, STABLE, RESOLVED).
model AthleteInjury {
  // primary key
  athleteInjuryId Int @id @default(autoincrement()) @map("athlete_injury_id")

  // fields
  /// Injury location/body part
  location  String
  /// Pain score on a normalized 0.0-1.0 scale (0.7 = 7/10 as reported by the athlete)
  painScore Float        @map("pain_score")
  /// Injury context/description
  context   String
  /// Injury status: WORSENING, IMPROVING, STABLE, or RESOLVED
  status    InjuryStatus

  // relationships
  athlete          Athlete        @relation(fields: [athleteId], references: [athleteId])
  athleteId        Int            @map("athlete_id")
  sourceActivity   EventActivity? @relation(fields: [sourceActivityId], references: [eventActivityId])
  sourceActivityId Int?           @map("source_activity_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([athleteId])
  @@index([sourceActivityId])
  @@map("athlete_injury")
}

/// Activity feedback embedding.
/// Vector embedding of activity feedback responses for semantic search and
/// AI-powered insights. Uses pgvector with 1536 dimensions (text-embedding-3-small).
/// One embedding per activity, generated from concatenated feedback answers.
model ActivityFeedbackEmbedding {
  // primary key
  activityFeedbackEmbeddingId Int @id @default(autoincrement()) @map("activity_feedback_embedding_id")

  // fields
  /// Concatenated feedback answers and comments (for reference)
  textContent String                      @map("text_content")
  /// Vector embedding (1536 dimensions for text-embedding-3-small, stored as pgvector)
  embedding   Unsupported("vector(1536)")

  // relationships
  activity        EventActivity @relation(fields: [eventActivityId], references: [eventActivityId])
  eventActivityId Int           @unique @map("event_activity_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("activity_feedback_embedding")
}
