// ============================================================================
// Training Plan Models
// ============================================================================
// Training plan architecture for periodized training:
// - TrainingPlan: High-level plan with goal and date range
// - Cycle: Training cycles within a plan (e.g., Base, Build, Taper)
// - TrainingWeek: Weekly structure within cycles
// - AthleteAvailability: Athlete's weekly schedule for plan generation
// - TrainingPlanAdjustment: Audit trail of automatic/manual plan changes
// ============================================================================

/// Training plan.
/// High-level training plan with a goal (e.g., "Finish UTMB 2025", "Sub-3:30 marathon").
/// Contains multiple cycles and can be in DRAFT, ACTIVE, COMPLETED, or ARCHIVED status.
model TrainingPlan {
  // primary key
  trainingPlanId Int @id @default(autoincrement()) @map("training_plan_id")

  // fields
  /// Plan name
  timeZone         String @default("UTC") @map("time_zone")
  name             String
  /// Plan description
  description      String?
  /// Training goal (e.g., "Finish UTMB 2025", "Sub-3:30 marathon")
  goal             String
  /// Plan start date
  startDate        DateTime   @map("start_date")
  /// Plan end date
  endDate          DateTime   @map("end_date")
  /// Plan status: DRAFT, ACTIVE, COMPLETED, or ARCHIVED
  status           PlanStatus @default(DRAFT)
  /// Primary sport this plan targets
  sportType        SportType  @default(RUNNING) @map("sport_type")
  /// Target/race distance in meters (optional, null for general fitness plans)
  targetDistance   Float?     @map("target_distance")
  /// Target/goal finish time in seconds (optional)
  targetTime       Int?       @map("target_time")
  /// Race date the plan builds towards (optional, null for open-ended plans)
  raceDate         DateTime?  @map("race_date")
  /// Number of training days per week requested by the athlete
  daysPerWeek      Int?       @map("days_per_week")
  /// Version of the plan generation engine that produced this plan
  generatorVersion String?    @map("generator_version")
  /// Full generation input (wizard answers + athlete context snapshot), for reproducibility
  generationInput  Json?      @map("generation_input")

  // relationships
  athlete     Athlete                 @relation(fields: [athleteId], references: [athleteId], onDelete: Cascade)
  athleteId   Int                     @map("athlete_id")
  cycles      Cycle[]
  adjustments TrainingPlanAdjustment[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([athleteId, status])
  @@map("training_plan")
}

/// Training plan adjustment.
/// Audit trail of every change made to a plan after generation, whether applied
/// automatically by the adaptation engine or manually by the athlete/coach.
/// Powers the "why did my plan change?" feed: an auto-adjusting plan is only
/// trustworthy if every change is explainable.
model TrainingPlanAdjustment {
  // primary key
  trainingPlanAdjustmentId Int @id @default(autoincrement()) @map("training_plan_adjustment_id")

  // fields
  /// What triggered the adjustment
  trigger   PlanAdjustmentTrigger
  /// Human-readable explanation shown to the athlete
  reason    String
  /// Structured diff of what changed (sessions moved/downgraded/removed, load deltas)
  changes   Json
  /// Whether the adjustment was applied automatically (true) or by a human (false)
  automatic Boolean               @default(true)

  // relationships
  trainingPlan   TrainingPlan  @relation(fields: [trainingPlanId], references: [trainingPlanId], onDelete: Cascade)
  trainingPlanId Int           @map("training_plan_id")
  trainingWeek   TrainingWeek? @relation(fields: [trainingWeekId], references: [trainingWeekId], onDelete: SetNull)
  trainingWeekId Int?          @map("training_week_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([trainingPlanId, createdAt])
  @@index([trainingWeekId])
  @@map("training_plan_adjustment")
}

/// Training week.
/// Represents a week within a training cycle. Contains training sessions
/// (Events) and can have a theme, target volume, and target training load.
model TrainingWeek {
  // primary key
  trainingWeekId Int @id @default(autoincrement()) @map("training_week_id")

  // fields
  /// Position in the cycle (1, 2, 3, ...)
  phase        CyclePhase?
  weekNumber   Int      @map("week_number")
  /// Week start date
  startDate    DateTime @map("start_date")
  /// Week end date
  endDate      DateTime @map("end_date")
  /// Week theme (e.g., "VO2 intervals", "Base building", "Taper week")
  theme        String?
  /// Target training volume in seconds
  targetVolume Int?     @map("target_volume")
  /// Target training load (TRIMP)
  targetLoad   Float?   @map("target_load")

  // relationships
  cycle       Cycle                    @relation(fields: [cycleId], references: [cycleId], onDelete: Cascade)
  cycleId     Int                      @map("cycle_id")
  sessions    Event[] // training sessions scheduled in this week
  adjustments TrainingPlanAdjustment[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([cycleId, weekNumber])
  @@map("training_week")
}

/// Athlete availability schedule.
/// Defines when an athlete is available for training during the week.
/// Used by training plan generation to schedule sessions at appropriate times.
model AthleteAvailability {
  // primary key
  athleteAvailabilityId Int @id @default(autoincrement()) @map("athlete_availability_id")

  // fields
  /// Day of week: 0=Sunday, 1=Monday, ..., 6=Saturday
  dayOfWeek Int                  @map("day_of_week")
  /// Start time in "HH:mm" format (24h), e.g., "08:00"
  startTime String               @map("start_time")
  /// End time in "HH:mm" format (24h), e.g., "12:00"
  endTime   String               @map("end_time")
  /// Availability priority: LOW, MEDIUM, or HIGH
  priority  AvailabilityPriority @default(MEDIUM)

  // relationships
  athlete   Athlete @relation(fields: [athleteId], references: [athleteId], onDelete: Cascade)
  athleteId Int     @map("athlete_id")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([athleteId, dayOfWeek])
  @@map("athlete_availability")
}
